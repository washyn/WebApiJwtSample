@{
    ViewData["Title"] = "Home Page";
    var clientUrl = "https://localhost:7162";
}

<div class="text-center">
    <h1 class="display-4">🔐 SSO Server</h1>
    <p class="lead">Servidor de autenticación centralizado</p>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="alert alert-success mt-4">
            <strong>✅ Sesión activa:</strong> @User.Identity.Name
        </div>
        <p>
            <a class="btn btn-primary" href="@clientUrl">Ir al SSO Client</a>
            <span class="mx-2">|</span>
            <a class="btn btn-outline-secondary" asp-action="Privacy" asp-controller="Home">Ver página protegida (Server)</a>
        </p>
    }
    else
    {
        <div class="alert alert-warning mt-4">
            <strong>⚠️ No autenticado</strong> - Inicia sesión para acceder a las aplicaciones.
        </div>
        <p>
            <a class="btn btn-success btn-lg" asp-action="Auth" asp-controller="Account">Iniciar Sesión</a>
        </p>
    }
</div>

<hr />

<div class="mt-5">
    <h4>📋 Claims del usuario (Server)</h4>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <ul class="list-group">
            @foreach (var a in User.Claims)
            {
                <li class="list-group-item">
                    <strong>@a.Type:</strong> @a.Value
                </li>
            }
        </ul>
    }
    else
    {
        <p class="text-muted">Sin claims disponibles. Inicia sesión.</p>
    }
</div>