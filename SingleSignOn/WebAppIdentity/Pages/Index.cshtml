@page
@model IndexModel
@{
    ViewData["Title"] = "Home page - WebAppIdentity (SSO Server)";
    var clientUrl = "https://localhost:7064";
}

<div class="text-center">
    <h1 class="display-4">WebAppIdentity - Servidor de Autenticación SSO</h1>
    <p class="lead">Esta aplicación administra usuarios con ASP.NET Core Identity y emite la cookie de autenticación compartida.</p>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                Estado de Sesión
            </div>
            <div class="card-body">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="alert alert-success">
                        <strong>Sesión activa.</strong> Cookie SSO emitida: <code>.SingleSignOn.SharedCookie</code>
                    </div>
                    <p><strong>Usuario:</strong> @User.Identity.Name</p>
                }
                else
                {
                    <div class="alert alert-info">
                        Registra un usuario o inicia sesión para generar la cookie compartida.
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                Probar SSO
            </div>
            <div class="card-body">
                <p>Después de iniciar sesión aquí, la sesión se reutilizará automáticamente en la aplicación cliente.</p>
                <a href="@clientUrl" class="btn btn-primary w-100">
                    Ir a WebAppClient (Probar SSO)
                </a>
            </div>
        </div>
    </div>
</div>
