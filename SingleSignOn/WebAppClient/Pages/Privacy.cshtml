@page
@model PrivacyModel
@using System.Security.Claims
@{
    ViewData["Title"] = "Privacy Policy - Página Protegida (SSO)";
}
<h1>@ViewData["Title"]</h1>

<p class="alert alert-success">
    Esta página requiere autenticación SSO. Si ves este contenido, tu sesión compartida está funcionando.
</p>

@if (User.Identity?.IsAuthenticated == true)
{
    <h4>Información del Usuario (desde la sesión SSO)</h4>
    <div class="card mb-3">
        <div class="card-body">
            <p class="card-text"><strong>Usuario:</strong> @User.Identity.Name</p>
            <p class="card-text"><strong>Es Autenticado:</strong> @User.Identity.IsAuthenticated</p>
            <p class="card-text"><strong>Tipo de Autenticación:</strong> @User.Identity.AuthenticationType</p>
        </div>
    </div>

    <h5>Claims</h5>
    <table class="table table-sm table-striped">
        <thead>
            <tr>
                <th>Type</th>
                <th>Value</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var claim in User.Claims)
            {
                <tr>
                    <td>@claim.Type</td>
                    <td>@claim.Value</td>
                </tr>
            }
        </tbody>
    </table>
}
